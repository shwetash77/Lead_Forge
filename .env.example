# Copy to .env and fill in. Never commit the real .env.

# Database: SQLite for local dev, PostgreSQL in production
DATABASE_URL=sqlite:///./leadforge.db
# DATABASE_URL=postgresql://leadforge:leadforge@db:5432/leadforge

# Shared secret the WordPress plugin sends as X-API-Key (leave empty to disable auth locally)
LEADFORGE_API_KEY=

# LLM scoring (leave empty to use the rule-based fallback)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# CRM sync (leave empty to skip)
HUBSPOT_TOKEN=
